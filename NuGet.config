<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
        <add key="fidelity-incremental" value="vendor/Fidelity.FSharp.Incremental" />
    </packageSources>
    <packageSourceMapping>
        <!-- key value for <packageSource> should match key values from <packageSources> element -->
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="fidelity-incremental">
            <package pattern="Fidelity.FSharp.Incremental*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
