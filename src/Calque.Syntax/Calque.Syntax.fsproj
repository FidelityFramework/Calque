  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="FsLexYacc" PrivateAssets="all" />
    <ProjectReference Include="..\Calque.Syntax.BuildTasks\Calque.Syntax.BuildTasks.fsproj" ReferenceOutputAssembly="false" OutputItemType="CalqueBuildTasksOutput" />
  </ItemGroup>

  <Target Name="AcquireCompilerFiles" BeforeTargets="CollectPackageReferences">
    <Exec Command="bash &quot;$(MSBuildThisFileDirectory)../../scripts/acquire-syntax&quot; &quot;$(FCSCommitHash)&quot;" />
  </Target>

  <PropertyGroup>
    <CalqueBuildTasksAssembly>$(MSBuildThisFileDirectory)..\Calque.Syntax.BuildTasks\bin\$(Configuration)\net10.0\Calque.Syntax.BuildTasks.dll</CalqueBuildTasksAssembly>
  </PropertyGroup>

  <UsingTask TaskName="Calque.Syntax.Build.FSharpEmbedResourceText" AssemblyFile="$(CalqueBuildTasksAssembly)" />

  <!-- The project-reference protocol owns the task build, including its global properties.
       Calling MSBuild.Build here would create a second instance able to overwrite the loaded DLL. -->
  <Target Name="GenerateCalqueTextResources" BeforeTargets="CoreResGen;PrepareForBuild" DependsOnTargets="ResolveProjectReferences">
    <Error Condition="'@(CalqueBuildTasksOutput)' == ''" Text="Calque syntax resource generation requires its resolved build-task project reference." />
    <MakeDir Directories="$(IntermediateOutputPath)" />

    <Calque.Syntax.Build.FSharpEmbedResourceText EmbeddedText="@(CalqueEmbeddedText)" IntermediateOutputPath="$(IntermediateOutputPath)">
      <Output TaskParameter="GeneratedSource" ItemName="_CalqueGeneratedTxtSource" />
      <Output TaskParameter="GeneratedResx" ItemName="_CalqueGeneratedResx" />
    </Calque.Syntax.Build.FSharpEmbedResourceText>

    <ItemGroup>
      <Compile Include="@(_CalqueGeneratedTxtSource)" CompileOrder="CompileBefore" />
      <FsGeneratedSource Include="@(_CalqueGeneratedTxtSource)" />
      <EmbeddedResource Include="@(_CalqueGeneratedResx)" />
      <FileWrites Include="@(_CalqueGeneratedTxtSource)" />
      <FileWrites Include="@(_CalqueGeneratedResx)" />
    </ItemGroup>
  </Target>
</Project>
